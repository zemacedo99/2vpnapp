<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>vpnhelper</AssemblyName>
    <RootNamespace>VpnContextHelper.Cli</RootNamespace>
    <!-- Run on the installed .NET 10 runtime without requiring the net8 runtime. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VpnContextHelper.Core\VpnContextHelper.Core.csproj" />
  </ItemGroup>

</Project>
