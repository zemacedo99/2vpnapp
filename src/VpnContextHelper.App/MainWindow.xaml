<Window x:Class="VpnContextHelper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPN Context Helper" Height="600" Width="680"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="VPN Context Helper" FontSize="22" FontWeight="Bold" />
        <TextBlock DockPanel.Dock="Top" x:Name="SubtitleText" Foreground="#666" TextWrapping="Wrap"
                   Margin="0,2,0,0"
                   Text="Read-only helper. It never connects/disconnects VPNs, changes routes, or touches credentials/MFA/SAML." />

        <Border DockPanel.Dock="Top" Margin="0,12,0,0" Padding="12" Background="#F3F4F6" CornerRadius="6">
            <StackPanel>
                <TextBlock x:Name="TrustedText" Margin="0,1" />
                <TextBlock x:Name="VpnText" Margin="0,1" TextWrapping="Wrap" />
                <TextBlock x:Name="CompanyText" Margin="0,1" FontWeight="SemiBold" />
                <TextBlock x:Name="ClientText" Margin="0,1" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="RefreshBtn" Content="Refresh" Click="RefreshBtn_Click" Padding="12,5" Margin="0,0,8,0" />
            <Button Content="Open FortiClient" Click="OpenForti_Click" Padding="12,5" Margin="0,0,8,0" />
            <Button Content="Diagnostic report…" Click="Report_Click" Padding="12,5" Margin="0,0,8,0" />
            <Button Content="IT request…" Click="ItRequest_Click" Padding="12,5" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="Notes &amp; guidance" FontWeight="Bold" Margin="0,14,0,4" />
        <ListBox x:Name="MessagesList" BorderBrush="#DDD">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
